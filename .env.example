# ========================
# 🔐 AZURE AD AYARLARI
# ========================
# Microsoft Azure AD'den aldığınız Client ID'yi buraya yazın
CLIENT_ID=your_client_id_here

# Tenant ID - Kişisel Microsoft hesapları için "consumers" kullanın
TENANT_ID=consumers

# ========================
# 📧 EMAIL FİLTRE AYARLARI
# ========================
# Raporları gönderen email adresi
SENDER_EMAIL=sender@example.com

# ========================
# 📁 KLASÖR AYARLARI
# ========================
# Masaüstü klasör yolu (Windows için örnek: C:\Users\YourUsername\Desktop)
# macOS/Linux için örnek: /Users/YourUsername/Desktop
MASAUSTU_PATH=C:\Users\YourUsername\Desktop

# ========================
# ⏰ TARİH FİLTRE AYARLARI
# ========================
# Bu tarihten sonraki mesajları filtrele (YYYY-MM-DD formatında)
MANUAL_DATE=2025-08-13
